{
  "name": "waypoint-differentiation-lab",
  "version": "1.0.0",
  "description": "MCP server and visual walkthrough for evidence-grounded lesson differentiation.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "waypoint-differentiation-lab": "dist/server.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "demo": "tsx src/demo.ts",
    "demo:reviewer": "tsx src/reviewer-demo.ts",
    "dev": "tsx src/server.ts",
    "smoke:mcp": "npm run build && node scripts/mcp-smoke.mjs",
    "polish:check": "node scripts/repo-polish-check.mjs",
    "preview:showcase": "node scripts/capture-showcase-preview.mjs",
    "qa:showcase": "node scripts/qa-showcase.mjs",
    "showcase:dev": "vite --config showcase/vite.config.js",
    "showcase:build": "vite build --config showcase/vite.config.js",
    "submission:check": "npm run build && npm test && node scripts/mcp-smoke.mjs && npm run demo && npm run showcase:build && npm run polish:check && npm run qa:showcase && npm run demo:reviewer",
    "test": "vitest run",
    "check": "npm run build && npm test && npm run demo && npm run showcase:build"
  },
  "keywords": [
    "mcp",
    "education",
    "special-education",
    "lesson-planning",
    "typescript"
  ],
  "author": "Yousef Ashraf",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
