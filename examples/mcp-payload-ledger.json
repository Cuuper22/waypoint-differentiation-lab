      "compactPercentOfFull": 24,
      "recommendations": 3,
      "materials": 3
    },
    {
      "mode": "balanced pass",
      "minutesAvailable": 15,
      "emphasis": "balanced",
      "compactChars": 3829,
      "fullChars": 16734,
      "compactPercentOfFull": 23,
      "recommendations": 5,
      "materials": 5
    },
    {
      "mode": "full support",
      "minutesAvailable": 45,
      "emphasis": "full-support",
      "compactChars": 6232,
      "fullChars": 28299,
      "compactPercentOfFull": 22,
      "recommendations": 9,
      "materials": 9
    }
  ],
  "callFlow": [
    {
      "id": "packet",
      "command": "generate_teacher_packet({ minutesAvailable: 15, emphasis: \"balanced\", detail: \"compact\" })",
      "contentChars": 642,
      "structuredContentChars": 3829,
      "hiddenPayload": "12,905 chars deferred until full detail is requested",
      "structuredFields": [
        "title",
        "useFirst",
        "modifications[]",
